theme_override_colors/font_color = Color(0, 0, 0, 1)
theme_override_fonts/font = ExtResource("1_hqttu")
text = "In this game you must click on the green 
faces to earn points and not click on the
red ones. If you don't click in time, they
dissapear. If you click a red one, you 
lose a point, but a green one gives you a
point."

[node name="main" type="Label" parent="." unique_id=1479131229]
visible = false
offset_right = 354.0
offset_bottom = 130.0
theme_override_colors/font_color = Color(0, 0, 0, 1)
theme_override_fonts/font = ExtResource("1_hqttu")
text = "Welcome to pretty awesome minigames!
A few things to know before you get 
started though. First of all, each game 
consists of five minigames, one of the
three unique ones. To win you must get a
score of twenty or better. Press the 
buttons to learn more about each game."

[node name="pizza" type="Label" parent="." unique_id=1935561734]
visible = false
offset_right = 354.0
offset_bottom = 130.0
theme_override_colors/font_color = Color(0, 0, 0, 1)
theme_override_fonts/font = ExtResource("1_hqttu")
text = "In this game you control a hungry 
stickman that wants to eat the falling
pizza. Use arrow keys to move the 
stickman under falling pizza to eat it.
Eating pizza gives +1 score."

[node name="hammer" type="Label" parent="." unique_id=246303633]
offset_right = 354.0
offset_bottom = 130.0
theme_override_colors/font_color = Color(0, 0, 0, 1)
theme_override_fonts/font = ExtResource("1_hqttu")
text = "In this game you try to get the highest 
score by timing a click so that you get 
the most points. The garker green  the
more points and the more red means 
less. The maximum points is 25, and the
minimum if you get red is -5"

